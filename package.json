{
  "name": "claria-web",
  "private": true,
  "version": "0.3.0-etapa1",
  "description": "CLARIA · La información, más clara para todos",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test:worker": "cd worker && node --test test/*.test.mjs",
