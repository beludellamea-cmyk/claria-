    "test": "npm run test:worker && npm run test:e2e && npm run test:pictos",
    "test:pictos": "node --test tests/pictos.test.mjs && node tests/e2e-pictos.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}